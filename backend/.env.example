# Database
POSTGRES_DB=enroll
POSTGRES_USER=enroll
POSTGRES_PASSWORD=enroll
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Optional: use sqlite for quick local smoke
# USE_SQLITE=1

# Google OAuth
GOOGLE_OAUTH_CLIENT_ID=

# GradGPT scraping (primary source)
GRADGPT_INDEX_URL=https://www.gradgpt.com/common-data-set
GRADGPT_REQUEST_TIMEOUT=30

# Niche scraping fallback (legacy)
NICHE_SESSION_STATE_PATH=backend/.secrets/niche_session.json
NICHE_PROFILE_DIR=backend/.secrets/playwright-profile
NICHE_BROWSER_CHANNEL=chrome
NICHE_PROFILE_ROOT=backend/.secrets/profiles
NICHE_AUTOMATION_PROFILES=profile_a,profile_b,profile_c
NICHE_PROXY_POOL=
NICHE_HEADLESS=0
NICHE_DEFAULT_MAX_SECTIONS=8
NICHE_MIN_DELAY_SEC=1.8
NICHE_MAX_DELAY_SEC=3.8

# Licensed feed ingestion
LICENSED_FEED_MODE=mock
LICENSED_FEED_MOCK_PATH=backend/apps/universities/fixtures/licensed_feed_mock.json
# LICENSED_FEED_URL=https://provider.example.com/universities
# LICENSED_FEED_TOKEN=replace_me

# Celery / Redis
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0
